# Database connection URL
# Local SQLite for testing:
DATABASE_URL="file:./dev.db"

# Supabase PostgreSQL Configuration:
# Transaction Connection Pooler (for application queries):
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection URL (port 5432 for Prisma migrations & schema pushes):
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase API & Cloud Storage credentials:
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Authentication & Session Security
JWT_SECRET="your-secure-random-jwt-secret-at-least-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AmarBondhon Matrimony"

# WebRTC & Video Calling (LiveKit or custom WebRTC server)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
